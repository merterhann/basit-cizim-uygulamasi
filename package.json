{
  "name": "basit-cizim-uygulamasi",
  "version": "1.3.0",
  "description": "macOS ekran üstü çizim katmanı — canlı yayın anlatımı için",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.merterhan.basitcizim",
    "productName": "BasitCizim",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "icon": "build/icon.icns",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "LSUIElement": true,
        "CFBundleDisplayName": "Basit Çizim Uygulaması"
      }
    }
  }
}
